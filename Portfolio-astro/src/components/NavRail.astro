---
// Left primary nav rail - written once, used by every page via
// BaseLayout, instead of 4 hand-copied versions each hardcoding its
// own "which link gets rail-active" state.
const { current } = Astro.props;

const ITEMS = [
  {
    key: "home",
    href: "/",
    label: "Home",
    icon: '<path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><path d="M9 22V12h6v10"/>',
  },
  {
    key: "projects",
    href: "/projects/",
    label: "Projects",
    icon: '<rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/>',
  },
  {
    key: "resume",
    href: "/resume/",
    label: "Resume",
    icon: '<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="8" y1="13" x2="16" y2="13"/><line x1="8" y1="17" x2="16" y2="17"/>',
  },
  {
    key: "observability",
    href: "/observability/",
    label: "Observability",
    icon: '<path d="M3 12h4l3 8 4-16 3 8h4"/>',
  },
  {
    key: "contact",
    href: "/contact/",
    label: "Contact",
    icon: '<path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22 6 12 13 2 6"/>',
  },
];
---
<nav class="rail rail-left" aria-label="Primary">
  {ITEMS.map((item) => (
    <a href={item.href} title={item.label} class={item.key === current ? "rail-active" : undefined}>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={item.icon} />
      <span class="rail-label">{item.label}</span>
    </a>
  ))}
</nav>
