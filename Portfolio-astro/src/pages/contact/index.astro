---
import BaseLayout from "../../layouts/BaseLayout.astro";
---
<BaseLayout
  title="Christopher Fickess | Site Reliability Engineer"
  description="Chris is a software developer specializing in Web Design"
  current="contact"
  pageTitle="Contact"
  logoSrc="/icon/fickess1.PNG"
>
  <section class="contact-page">
    <header class="contact-head">
      <p class="kicker">Contact</p>
      <h2>Get in Touch</h2>
      <p class="contact-intro">Questions, project ideas, or just want to say hello. This goes straight to my inbox, no third-party form service involved.</p>
    </header>
    <div class="contact-grid">
      <div class="contact-form">
        <form id="contact-form" method="POST" name="contact" data-netlify="true" data-netlify-honeypot="bot-field">
          <input type="hidden" name="form-name" value="contact" />
          <p class="form-honeypot" aria-hidden="true">
            <label>Don't fill this out if you're human: <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
          </p>
          <div class="form-row">
            <div class="form-field">
              <label for="first-name">First name</label>
              <input type="text" name="first-name" id="first-name" required placeholder="Jane">
            </div>
            <div class="form-field">
              <label for="last-name">Last name</label>
              <input type="text" name="last-name" id="last-name" required placeholder="Doe">
            </div>
          </div>
          <div class="form-field">
            <label for="email">Email</label>
            <input type="email" name="email" id="email" required placeholder="jane@example.com">
          </div>
          <div class="form-field">
            <label for="message">Message</label>
            <textarea name="message" id="message" cols="20" rows="5" placeholder="What's on your mind?"></textarea>
          </div>
          <button type="submit" class="btn btn-primary">Submit</button>
          <p class="contact-note">Sent straight from this page, no email client required.</p>
        </form>
        <p id="contact-status" class="contact-status" hidden></p>
      </div>
      <div class="space-illustration-card" aria-hidden="true">
        <svg viewBox="0 0 500 500" fill="none" xmlns="http://www.w3.org/2000/svg" class="space-illustration">
          <circle cx="40" cy="60" r="1.6" fill="var(--text-muted)" opacity="0.7"><animate attributeName="opacity" values="0.7;0.1;0.7" dur="3.2s" begin="0s" repeatCount="indefinite" /></circle>
          <circle cx="95" cy="30" r="2" fill="var(--text-muted)" opacity="0.6"><animate attributeName="opacity" values="0.6;0.1;0.6" dur="2.6s" begin="0.4s" repeatCount="indefinite" /></circle>
          <circle cx="160" cy="70" r="1.4" fill="var(--text-muted)" opacity="0.8"><animate attributeName="opacity" values="0.8;0.15;0.8" dur="3.6s" begin="1s" repeatCount="indefinite" /></circle>
          <circle cx="230" cy="40" r="1.8" fill="var(--text-muted)" opacity="0.5"><animate attributeName="opacity" values="0.5;0.1;0.5" dur="2.9s" begin="0.7s" repeatCount="indefinite" /></circle>
          <circle cx="35" cy="150" r="2.2" fill="var(--text-muted)" opacity="0.6"><animate attributeName="opacity" values="0.6;0.1;0.6" dur="3.4s" begin="1.6s" repeatCount="indefinite" /></circle>
          <circle cx="455" cy="55" r="1.6" fill="var(--text-muted)" opacity="0.7"><animate attributeName="opacity" values="0.7;0.1;0.7" dur="3.1s" begin="0.3s" repeatCount="indefinite" /></circle>
          <circle cx="410" cy="110" r="2" fill="var(--text-muted)" opacity="0.55"><animate attributeName="opacity" values="0.55;0.1;0.55" dur="2.7s" begin="1.2s" repeatCount="indefinite" /></circle>
          <circle cx="470" cy="190" r="1.4" fill="var(--text-muted)" opacity="0.7"><animate attributeName="opacity" values="0.7;0.1;0.7" dur="3.8s" begin="0.9s" repeatCount="indefinite" /></circle>
          <circle cx="60" cy="300" r="1.8" fill="var(--text-muted)" opacity="0.6"><animate attributeName="opacity" values="0.6;0.1;0.6" dur="3s" begin="1.9s" repeatCount="indefinite" /></circle>
          <circle cx="470" cy="330" r="1.6" fill="var(--text-muted)" opacity="0.65"><animate attributeName="opacity" values="0.65;0.1;0.65" dur="2.5s" begin="0.5s" repeatCount="indefinite" /></circle>
          <circle cx="30" cy="430" r="1.4" fill="var(--text-muted)" opacity="0.55"><animate attributeName="opacity" values="0.55;0.1;0.55" dur="3.3s" begin="1.4s" repeatCount="indefinite" /></circle>
          <circle cx="440" cy="440" r="2" fill="var(--text-muted)" opacity="0.6"><animate attributeName="opacity" values="0.6;0.1;0.6" dur="2.8s" begin="0.2s" repeatCount="indefinite" /></circle>
          <circle cx="250" cy="470" r="1.6" fill="var(--text-muted)" opacity="0.5"><animate attributeName="opacity" values="0.5;0.1;0.5" dur="3.5s" begin="1.1s" repeatCount="indefinite" /></circle>
          <circle cx="330" cy="460" r="1.4" fill="var(--text-muted)" opacity="0.65"><animate attributeName="opacity" values="0.65;0.1;0.65" dur="2.6s" begin="1.7s" repeatCount="indefinite" /></circle>

          <ellipse cx="330" cy="150" rx="112" ry="24" fill="none" stroke="var(--border)" stroke-width="2" transform="rotate(-18 330 150)" />
          <circle cx="330" cy="150" r="55" fill="var(--accent)" opacity="0.92" />
          <path d="M 330 95 A 55 55 0 0 1 330 205 A 85 32 0 0 0 330 95 Z" fill="#000" opacity="0.18" />

          <g transform="translate(330 150)">
            <animateTransform attributeName="transform" type="rotate" from="0 0 0" to="360 0 0" dur="10s" repeatCount="indefinite" additive="sum" />
            <circle cx="95" cy="0" r="7" fill="var(--text)" />
            <rect x="88" y="-13" width="14" height="5" rx="1" fill="var(--text)" opacity="0.8" />
            <rect x="88" y="8" width="14" height="5" rx="1" fill="var(--text)" opacity="0.8" />
          </g>

          <g transform="translate(95 400)">
            <polygon points="-22,30 22,30 0,-6" fill="var(--text-muted)" />
            <ellipse cx="0" cy="-10" rx="26" ry="13" fill="none" stroke="var(--text)" stroke-width="3" transform="rotate(-25 0 -10)" />
            <circle cx="0" cy="-10" r="4" fill="var(--accent)" />
          </g>
          <circle cx="95" cy="390" r="14" fill="none" stroke="var(--accent)" stroke-width="2.5" opacity="0.85">
            <animate attributeName="r" values="14;90" dur="2.6s" begin="0s" repeatCount="indefinite" />
            <animate attributeName="opacity" values="0.85;0" dur="2.6s" begin="0s" repeatCount="indefinite" />
          </circle>
          <circle cx="95" cy="390" r="14" fill="none" stroke="var(--accent)" stroke-width="2.5" opacity="0.85">
            <animate attributeName="r" values="14;90" dur="2.6s" begin="0.9s" repeatCount="indefinite" />
            <animate attributeName="opacity" values="0.85;0" dur="2.6s" begin="0.9s" repeatCount="indefinite" />
          </circle>
          <circle cx="95" cy="390" r="14" fill="none" stroke="var(--accent)" stroke-width="2.5" opacity="0.85">
            <animate attributeName="r" values="14;90" dur="2.6s" begin="1.8s" repeatCount="indefinite" />
            <animate attributeName="opacity" values="0.85;0" dur="2.6s" begin="1.8s" repeatCount="indefinite" />
          </circle>
        </svg>
      </div>
    </div>
  </section>
</BaseLayout>
