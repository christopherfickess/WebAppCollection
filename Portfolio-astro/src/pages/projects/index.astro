---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { Image } from "astro:assets";
import website1 from "../../assets/img/Website1.PNG";
import website2 from "../../assets/img/Website2.PNG";
import website3 from "../../assets/img/Website3.PNG";
import travelAdvisor from "../../assets/img/TravelAdvisor.png";
---
<BaseLayout
  title="Christopher Fickess | Site Reliability Engineer"
  description="Chris is a software developer specializing in Web Design"
  current="projects"
  pageTitle="Projects"
  logoSrc="/icon/fickess1.PNG"
>
  <section class="projects-page">
    <header class="projects-head">
      <p class="kicker">Projects</p>
      <h2>What I build</h2>
      <p class="projects-intro">A mix of real infrastructure work and the front-end practice that got me comfortable with the web side of this site. The homelab below is actively maintained; after it come a modern site template and the three early learning exercises it grew out of.</p>
    </header>

    <div class="featured-project">
      <div class="featured-project-copy">
        <span class="featured-label">Featured &middot; actively maintained</span>
        <h3>Starlight: Personal Kubernetes Homelab</h3>
        <p>A self-hosted Kubernetes cluster run the way production infrastructure should be: every change goes through Flux and a pull request, nothing gets applied by hand. It's where I test ideas (GitOps workflows, policy enforcement, zero-trust networking) before they go near a real environment, and where a few of my own tools actually run.</p>
        <ul class="featured-facts">
          <li><strong>GitOps:</strong> every change through Flux + a PR, nothing applied by hand</li>
          <li><strong>Zero-trust networking:</strong> admin surfaces are Tailscale-only, never public</li>
          <li><strong>Policy &amp; runtime security:</strong> Kyverno, Tetragon (eBPF), Trivy scanning</li>
          <li><strong>Full observability:</strong> Grafana, Prometheus, Loki, Alertmanager</li>
        </ul>
        <ul class="skills">
          <li>#kubernetes</li>
          <li>#flux</li>
          <li>#terraform</li>
          <li>#tailscale</li>
          <li>#kyverno</li>
        </ul>
      </div>
      <div class="stack-card" aria-hidden="true">
        <div class="stack-layer">
          <span class="stack-layer-name">GitOps</span>
          <span class="stack-layer-detail">Flux &middot; PR-reviewed</span>
        </div>
        <div class="stack-layer">
          <span class="stack-layer-name">Security</span>
          <span class="stack-layer-detail">Kyverno &middot; Tetragon &middot; Trivy</span>
        </div>
        <div class="stack-layer">
          <span class="stack-layer-name">Observability</span>
          <span class="stack-layer-detail">Grafana &middot; Prometheus &middot; Loki</span>
        </div>
        <div class="stack-layer">
          <span class="stack-layer-name">Platform</span>
          <span class="stack-layer-detail">Kubernetes &middot; Tailscale</span>
        </div>
      </div>
    </div>

    <h3 class="section-divider">Templates</h3>
    <div class="projects-grid">
      <a class="project-card" href="/travel-advisor/" target="_blank" rel="noopener">
        <div class="project-thumb">
          <Image src={travelAdvisor} alt="Gredin Travel Advisor template screenshot" width={640} format="webp" quality={70} loading="lazy" />
        </div>
        <div class="project-copy">
          <h3>Gredin Travel Advisor</h3>
          <p>Modern rebuild of Travelly: guides to eight destinations, built from JS component classes and one data file.</p>
        </div>
      </a>
    </div>

    <h3 class="section-divider">Earlier practice builds</h3>
    <div class="projects-grid">
      <a class="project-card" href="/Website1/index.html" target="_blank" rel="noopener">
        <div class="project-thumb">
          <Image src={website1} alt="Website1: Flourish Collective screenshot" width={640} format="webp" quality={70} loading="lazy" />
        </div>
        <div class="project-copy">
          <h3>Flourish Collective</h3>
          <p>Early flexbox practice: course-style landing page, starry hero, green CTA.</p>
        </div>
      </a>
      <a class="project-card" href="/Website2/index.html" target="_blank" rel="noopener">
        <div class="project-thumb">
          <Image src={website2} alt="Website2: Fox Photography screenshot" width={640} format="webp" quality={70} loading="lazy" />
        </div>
        <div class="project-copy">
          <h3>Fox Photography</h3>
          <p>Nature/photo one-pager, fox mascot, plum accent, Formspree contact form.</p>
        </div>
      </a>
      <a class="project-card" href="/Website3/index.html" target="_blank" rel="noopener">
        <div class="project-thumb">
          <Image src={website3} alt="Website3: Travelly screenshot" width={640} format="webp" quality={70} loading="lazy" />
        </div>
        <div class="project-copy">
          <h3>Travelly</h3>
          <p>Travel-agency landing page, animated clouds, sky blue, Poppins + Pattaya.</p>
        </div>
      </a>
    </div>
  </section>
</BaseLayout>
